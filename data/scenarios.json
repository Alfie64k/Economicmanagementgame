{
 "scenarios": [
  {
   "id": "tut_budget",
   "name": "1. Your First Budget",
   "kind": "tutorial",
   "country": "GBR",
   "years": 3,
   "difficulty": "Easy",
   "description": "You are the new UK Chancellor. Learn the budget screen: bring the deficit down without tipping the economy into recession.",
   "goals": [
    {
     "label": "Deficit below 4.5% of GDP",
     "metric": "deficit",
     "op": "<",
     "value": 0.045,
     "byMonth": 36,
     "weight": 1.0
    },
    {
     "label": "Unemployment below 5.2%",
     "metric": "unemp",
     "op": "<",
     "value": 0.052,
     "byMonth": 36,
     "weight": 1.0
    },
    {
     "label": "Approval above 30%",
     "metric": "approval",
     "op": ">",
     "value": 0.3,
     "byMonth": 36,
     "weight": 1.0
    }
   ],
   "setup": [],
   "events": [],
   "hints": [
    {
     "month": 0,
     "text": "Open Budget and compare revenue with spending. Add changes to your turn plan: they take effect, and cost political capital, when you press End turn."
    },
    {
     "month": 3,
     "text": "Check the advisors: the Finance Minister and Social Policy Minister will disagree. You decide."
    },
    {
     "month": 12,
     "text": "Open Forecast to preview the effect of a change before you commit to it."
    }
   ],
   "unlock": null
  },
  {
   "id": "tut_inflation",
   "name": "2. Taming Inflation",
   "kind": "tutorial",
   "country": "GBR",
   "years": 4,
   "difficulty": "Easy",
   "description": "A cost-of-living shock has pushed inflation toward 9%. Use monetary and fiscal policy to bring it back to target without a deep slump.",
   "goals": [
    {
     "label": "Inflation below 3.5%",
     "metric": "infl",
     "op": "<",
     "value": 0.035,
     "byMonth": 48,
     "weight": 1.0
    },
    {
     "label": "Unemployment below 7%",
     "metric": "unemp",
     "op": "<",
     "value": 0.07,
     "byMonth": 48,
     "weight": 1.0
    }
   ],
   "setup": [
    {
     "kind": "mod",
     "key": "inflation",
     "value": 0.05,
     "months": 30,
     "scale": "none"
    },
    {
     "kind": "state",
     "key": "approval",
     "value": -0.05,
     "months": 0,
     "scale": "none"
    }
   ],
   "events": [
    {
     "id": "oil_supply_shock",
     "month": 0,
     "country": false
    }
   ],
   "hints": [
    {
     "month": 0,
     "text": "The central bank follows a rule by default. Pin the policy rate manually in Monetary Policy if you disagree, at a political-capital cost."
    },
    {
     "month": 6,
     "text": "Expectations matter: credibility policies such as central-bank independence slow the spiral."
    }
   ],
   "unlock": "tut_budget"
  },
